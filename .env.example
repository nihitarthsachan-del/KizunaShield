# KizunaShield email automation
# Preferred: deploy google-apps-script/Code.gs as a Google Web App and paste its URL.
EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
SCAN_NOTIFY_EMAIL=madipadige.nikhil4u@gmail.com

# Optional SMTP fallback if EMAIL_WEBHOOK_URL is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com
SMTP_FROM_NAME=KizunaShield
